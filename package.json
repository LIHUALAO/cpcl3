{
  "name": "pcl3",
  "productName": "PCL3",
  "version": "0.1.0",
  "description": "A Minecraft launcher rewrite: direct Mojang metadata, mirror-aware downloads, Microsoft OAuth.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/ts-resolve.mjs --test \"test/**/*.test.ts\"",
    "test:watch": "node --import ./test/ts-resolve.mjs --test --watch \"test/**/*.test.ts\"",
    "test:real": "node scripts/run-real-test.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:hygiene:full": "node scripts/check-hygiene.mjs --tmp",
    "clean:tmp": "node scripts/check-hygiene.mjs --clean",
    "verify": "npm run typecheck && npm run check:encoding && npm run check:hygiene && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
